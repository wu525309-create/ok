# 管理员密钥（留空则首次启动自动生成并写入 data/votes.db 的 meta 表）
ADMIN_KEY=

# 站点标题
SITE_TITLE=图片投票

# 投稿码 HMAC 密钥（用于派生每位投稿人的「只能传图」密码）
# 部署到 Vercel 时务必设置为一段随机字符串，保证投稿码无法被伪造
KEY_HMAC_SECRET=

# ---- Cloudflare R2（图片存这里）----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# R2 图片的公开访问前缀（通过 R2 自定义域或 Cloudflare Workers 绑定）
# 例如：https://files.example.com  （末尾不要带 /）
R2_PUBLIC_URL=
